# -----------------------------------------------------------------------------
# Secrets / environment credentials (settings.env)
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN="your_discord_token_here"
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
MONGODB_URI="your_mongodb_cluster_uri_here"
GEMINI_API_KEY_EMBEDDING="your_gemini_embedding_key_here"

# Core model runtime
GROQ_MODEL="llama-3.3-70b-versatile"
COMPRESSION_THRESHOLD="10"

# -----------------------------------------------------------------------------
# App operational settings (settings.app)
# -----------------------------------------------------------------------------
DISCORD_MESSAGE_LIMIT="2000"
METRICS_PORT="8000"

ROUTER_MODEL="gemini-2.5-flash"
ROUTER_TEMPERATURE="0.1"

BOT_DEBUG_ENABLED="0"
BOT_DEBUG_INCLUDE_IN_REPLY="0"

APP_DB_NAME="pso2_bot"
MONGO_MEMORY_COLLECTION="rp_memory"
MEMORY_MAX_BUFFER="30"


LOCAL_VLM_URL="http://127.0.0.1:9707/v1"
LOCAL_VLM_MODEL="local-model"
VISION_MAX_TOKENS="512"
VISION_TEMPERATURE="0.2"

# -----------------------------------------------------------------------------
# Scraper operational settings (settings.scraper)
# -----------------------------------------------------------------------------
WIKI_API_BASE="https://pso2na.arks-visiphone.com/api.php"
WIKI_BASE_URL="https://pso2na.arks-visiphone.com/wiki"
SCRAPER_USER_AGENT="PSO2-Bot-Scraper/3.0 (research only)"
WIKI_REQUEST_DELAY="1.2"
WIKI_CACHE_TTL_H="24"
WIKI_MIN_CHUNK_LEN="30"
WIKI_BATCH_SIZE="50"

# Official players source ingestion
PLAYERS_BASE_URL="https://pso2.com/players/"
PLAYERS_ALLOWED_PATH_PREFIX="/players/"
PLAYERS_MAX_PAGES="40"
PLAYERS_FETCH_TIMEOUT="20"
PLAYERS_REQUEST_DELAY="0.6"
PLAYERS_MIN_TEXT_LEN="160"
PLAYERS_CHUNK_SIZE="1800"
PLAYERS_CHUNK_OVERLAP="220"
PLAYERS_GAME_MODE="NGS"
PLAYERS_CATEGORY="official"